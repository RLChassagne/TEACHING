    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "g = [[2, 1], [8, 1]]\n",
    "g_inv=np.linalg.inv(g)\n",
    "print('G_inv=', g_inv)\n",
    "\n",
    "d= np.array([[19], [22]])\n",
    "\n",
    "#product G_inv with d\n",
    "m=np.dot(g_inv, d)\n",
    "\n",
    "print('m=', m)\n",
    "\n",
    "# Related to plotting\n",
    "x = np.linspace(0,18,10)\n",
    "y = m[0]*x + m[1]\n",
    "fig = plt.figure()\n",
    "plt.plot(x,y, 'g', label =\"Model\")\n",
    "plt.xlabel('Depth (m)')\n",
    "plt.ylabel('Temperature degree celsius')\n",
    "plt.plot(2, 19, 'o', color ='blue', label =\"data\" )\n",
    "plt.plot(8, 22, 'o', color ='blue', )\n",
    "plt.legend() \n",
    "plt.show()\n"
  
