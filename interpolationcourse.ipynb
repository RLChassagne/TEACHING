    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.interpolate import griddata\n",
    "# Données\n",
    "points = np.array([\n",
    "    [0, 0, 7.1],\n",
    "    [50, 10, 6.8],\n",
    "    [100, 0, 7.6],\n",
    "    [150, 20, 8.0],\n",
    "    [200, 0, 9.2],\n",
    "    [25, 50, 6.3],\n",
    "    [125, 60, 7.9],\n",
    "    [75, 90, 8.5],\n",
    "    [175, 80, 9.0],\n",
    "    [225, 60, 10.1],\n",
    "    [250, 20, 10.4],\n",
    "    [300, 50, 11.0]\n",
    "])\n",
    "\n",
    "x = points[:, 0]\n",
    "y = points[:, 1]\n",
    "z = points[:, 2]\n",
    "\n",
    "# Grille régulière\n",
    "xi = np.linspace(min(x), max(x), 200)\n",
    "yi = np.linspace(min(y), max(y), 200)\n",
    "X, Y = np.meshgrid(xi, yi)\n",
    "\n",
    "# Interpolation (cubic / linear / nearest)\n",
    "Z = griddata((x, y), z, (X, Y), method='linear')\n",
    "\n",
    "# Affichage\n",
    "plt.figure(figsize=(8, 6))\n",
    "contour = plt.contourf(X, Y, Z, levels=20, cmap=\"viridis\")\n",
    "plt.scatter(x, y, c=z, edgecolor='k', cmap=\"viridis\", s=80, marker=\"o\")\n",
    "plt.colorbar(contour, label=\"Porosity (%)\")\n",
    "plt.xlabel(\"x (m)\")\n",
    "plt.ylabel(\"y (m)\")\n",
    "plt.title(\"Porosity Interpolation Map\")\n",
    "plt.show()"
  
